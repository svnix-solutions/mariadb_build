# Root password. Required. This is also the phpMyAdmin login, since
# phpMyAdmin authenticates directly against MariaDB and has no user store
# of its own. Provision least-privilege accounts before real use.
MARIADB_ROOT_PASSWORD=changeme

# Host path the backups are written to. Required -- there is no default,
# because a wrong one silently fills the node's local disk.
DBBACKUP_PATH=/mnt/dbbackup

# Address the ports bind to. Defaults to 127.0.0.1 (loopback only).
MARIADB_BIND=127.0.0.1
PMA_BIND=127.0.0.1

# Days of dumps to keep.
BACKUP_RETENTION_DAYS=14

# Tuning. max-allowed-packet matters if Frappe/ERPNext uses this instance --
# its own reference config sets 512M and large imports fail below it.
# innodb-buffer-pool-size is conventionally 60-70% of RAM dedicated to the DB.
MARIADB_MAX_ALLOWED_PACKET=64M
MARIADB_INNODB_BUFFER_POOL_SIZE=256M

# Optional; MariaDB's defaults shown. Raise the table caches above the total
# table count across databases (a Frappe site is ~1000 tables). tmp-table-size
# also sets max-heap-table-size -- the smaller of the two is what applies.
# The slow log is written to the datadir as <container-id>-slow.log.
MARIADB_INNODB_LOG_FILE_SIZE=96M
MARIADB_TABLE_DEFINITION_CACHE=400
MARIADB_TABLE_OPEN_CACHE=2000
MARIADB_INNODB_OPEN_FILES=2000
MARIADB_TMP_TABLE_SIZE=16M
MARIADB_SLOW_QUERY_LOG=0
MARIADB_LONG_QUERY_TIME=10

# Shared docker network name for the two services.
DB_NETWORK=db
