# Root password. Required. This is also the phpMyAdmin login, since
# phpMyAdmin authenticates directly against MariaDB and has no user store
# of its own. Provision least-privilege accounts before real use.
MARIADB_ROOT_PASSWORD=changeme

# Host path the backups are written to. Required -- there is no default,
# because a wrong one silently fills the node's local disk.
DBBACKUP_PATH=/mnt/dbbackup

# Address the ports bind to. Defaults to 127.0.0.1 (loopback only).
MARIADB_BIND=127.0.0.1
PMA_BIND=127.0.0.1

# Days of dumps to keep.
BACKUP_RETENTION_DAYS=14

# Shared docker network name for the two services.
DB_NETWORK=db
